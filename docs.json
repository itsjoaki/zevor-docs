{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Zevor",
  "colors": {
    "primary": "#00d084",
    "light": "#00d084",
    "dark": "#00b073"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/logo.png",
    "dark": "/logo/logo.png",
    "href": "https://zevor.ai"
  },
  "background": {
    "color": {
      "dark": "#0B0C0E"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Soporte",
        "href": "mailto:hello@zevor.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Ir a Zevor",
      "href": "https://zevor.ai/crear"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/zevorhq",
      "instagram": "https://www.instagram.com/zevor.ai"
    }
  },
  "navigation": {
    "languages": [
      {
        "language": "es",
        "default": true,
        "groups": [
          {
            "group": "Empezar",
            "pages": ["es/introduccion", "es/primeros-pasos"]
          },
          {
            "group": "Modos",
            "pages": [
              "es/modos/video",
              "es/modos/motion",
              "es/modos/personajes",
              "es/modos/imagen"
            ]
          },
          {
            "group": "Herramientas de vídeo",
            "pages": [
              "es/herramientas-video/quitar-fondo-video",
              "es/herramientas-video/escalar-video",
              "es/herramientas-video/camara-lenta",
              "es/herramientas-video/foto-que-habla"
            ]
          },
          {
            "group": "Recetas",
            "pages": [
              "es/recetas/ai-influencer",
              "es/recetas/motion-clip",
              "es/recetas/restaurar-foto",
              "es/recetas/foto-que-habla"
            ]
          },
          {
            "group": "Más",
            "pages": ["es/herramientas", "es/creditos-y-planes", "es/faq"]
          }
        ]
      },
      {
        "language": "en",
        "groups": [
          {
            "group": "Start here",
            "pages": ["en/introduction", "en/getting-started"]
          },
          {
            "group": "Modes",
            "pages": [
              "en/modes/video",
              "en/modes/motion",
              "en/modes/characters",
              "en/modes/image"
            ]
          },
          {
            "group": "Video tools",
            "pages": [
              "en/video-tools/remove-video-background",
              "en/video-tools/upscale-video",
              "en/video-tools/slow-motion",
              "en/video-tools/talking-photo"
            ]
          },
          {
            "group": "Recipes",
            "pages": [
              "en/recipes/ai-influencer",
              "en/recipes/motion-clip",
              "en/recipes/restore-photo",
              "en/recipes/talking-photo"
            ]
          },
          {
            "group": "More",
            "pages": ["en/tools", "en/credits-and-plans", "en/faq"]
          }
        ]
      }
    ]
  }
}
